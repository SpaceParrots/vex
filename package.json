{
  "name": "@spaceparrots/vex",
  "version": "1.1.0",
  "description": "CLI tool and MCP server for Vendure Admin API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vex": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "vendure",
    "mcp",
    "graphql",
    "admin-api",
    "claude",
    "cli"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpaceParrots/vex.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "commander": "^14.0.3",
    "graphql": "^16.10.0",
    "graphql-request": "^7.1.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.25.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^3.2.6"
  }
}
